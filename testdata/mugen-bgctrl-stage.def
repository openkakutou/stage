; Hand-written MUGEN-style stage exercising BGCtrlDef / BGCtrl blocks.
; (synthetic fixture, see testdata/README.md)

[Info]
name = "Rooftop Night"
author = "Fixture Author"   ; trailing comment

[bgdef]
spr = rooftop.sff

[StageInfo]
zoffset = 200
localcoord = 320,240

[Camera]
boundleft = -100
boundright = 100

[PlayerInfo]
leftbound = -1000
rightbound = 1000

[BG Sky]
type = normal
spriteno = 0,0
layerno = 0
start = 0,0

[BG Neon]
type  = anim
actionno = 10
layerno = 1

[Begin Action 10]
0,0, 0,0, 5
0,1, 0,0, 5

; --- lights controller ---
[BGCtrlDef Lights]
ctrlID = 1   ; shared id
looptime = 120

[BGCtrl Blink]
Type = Visible
; toggled on a timer
time = 30
value = 0   ; hidden
ctrlID = 1

[bgctrl Fade]
type = PalFX
time = 60,90,120
add = 10, 20, 30  ; brighten
mul = 256,256,256

[BGCtrl Shake]
type = AnimTrans
value = 2

[BGCtrlDef Lights]
looptime = 240

[BGCtrl Again]
type = enable
time = 5
value = "1"

[BGCtrlDef Empty]
ctrlID = 7
